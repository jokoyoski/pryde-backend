# ==========================================
# Database (PrydeConnection)
# ==========================================
PrydeConnection__Host=
PrydeConnection__Port=5432
PrydeConnection__Database=pryde-dev
PrydeConnection__Username=
PrydeConnection__Password=
PrydeConnection__SslMode=Require

# ==========================================
# JWT (JwtSettings)
# ==========================================
JWTSETTINGS__KEY=
JWTSETTINGS__ISSUER=Pryde.Api
JWTSETTINGS__AUDIENCE=Pryde.Client
JWTSETTINGS__ACCESSTOKENEXPIRYMINUTES=60
JWTSETTINGS__REFRESHTOKENEXPIRYDAYS=30

# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Resend Email
# ==========================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@pryde.ng
EMAIL_FROM_NAME=Pryde
EMAIL_OTP_EXPIRY_MINUTES=10

# ==========================================
# Dojah KYC (Dojah)
# ==========================================
Kyc__ActiveProvider=Dojah
Dojah__Enabled=false
Dojah__BaseUrl=
Dojah__AppId=
Dojah__ApiToken=
Dojah__PublicKey=
Dojah__PrivateKey=
Dojah__ShareableLink=

# ==========================================
# Smile ID KYC
# ==========================================
SmileId__PartnerId=
SmileId__ApiKey=
SmileId__Environment=Sandbox
SmileId__SandboxBaseUrl=https://testapi.smileidentity.com/
SmileId__ProductionBaseUrl=https://api.smileidentity.com/
SmileId__CallbackUrl=https://pryde-backend-vjfh.onrender.com/api/v1/kyc/providers/smile-id/callback
SmileId__RedirectUrl=
SmileId__CompanyName=Pryde
SmileId__DataPrivacyPolicyUrl=
SmileId__MaximumCallbackAgeMinutes=5
SmileId__IdentityType=NIN_V2

# ==========================================
# Paystack Driver Bank Accounts
# ==========================================
Paystack__Enabled=false
Paystack__BaseUrl=https://api.paystack.co
Paystack__PublicKey=
Paystack__SecretKey=
Paystack__ExpectedDomain=live
